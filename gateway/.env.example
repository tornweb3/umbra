# Copy to .env and fill in. Never commit the real file.

# Postgres. Schema lives in schema.sql; apply migrations/ in order.
DATABASE_URL=postgres://gateway:CHANGEME@127.0.0.1:5432/xmr_gateway

# 32-byte hex (64 chars). Encrypts merchant view keys and Shopify credentials
# at rest. Generate once: openssl rand -hex 32
# Changing it makes every stored view key undecryptable.
MASTER_KEY=

# Password monero-wallet-rpc uses for the wallet files it creates.
WALLET_PASSWORD=

# monero-wallet-rpc, started with --wallet-dir. Runs against your own node.
WALLET_RPC_URL=http://127.0.0.1:18083/json_rpc
# monerod. A public node works for testing; run your own in production.
DAEMON_RPC_URL=http://127.0.0.1:18081/json_rpc
# mainnet | stagenet | testnet — must match how wallet-rpc was started.
MONERO_NETWORK=mainnet

PORT=3000
# Loopback unless something else controls access to the port (e.g. a container).
BIND_ADDRESS=127.0.0.1
# Public HTTPS origin. Checkout links, Shopify webhooks and buyer pay links are
# built from this, so it must be the final host (no redirect to www).
PUBLIC_BASE_URL=https://pay.example.com

# Worker loop and confirmation threshold.
POLL_INTERVAL_MS=15000
CONFIRMATIONS=10
# Drop a detected 0-conf payment whose tx vanished after this many minutes.
REVERT_AFTER_MIN=30
# Give up on a webhook after this many attempts (exponential backoff).
WEBHOOK_MAX_ATTEMPTS=8

# Shopify bridge (optional).
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SYNC_INTERVAL_MS=120000
SHOPIFY_INVOICE_EXPIRY_MIN=60
# Testing only: routes Admin API calls to tools/shopify-mock.mjs. Leave unset.
# SHOPIFY_TEST_API_BASE=http://127.0.0.1:4100

# ---- security -------------------------------------------------------------
# Account creation is disabled unless this is set. Set it, create your
# merchant, then remove it again. Sent as the X-Signup-Token header.
SIGNUP_TOKEN=

# Set when the gateway runs behind a reverse proxy, so rate limits see the real
# client IP: "1" trusts one hop, or give a subnet (e.g. 10.0.0.0/8).
TRUST_PROXY=

# Webhook URLs that resolve to private or loopback addresses are refused, which
# stops the gateway being used to reach inside your network. Only turn this on
# for local testing against something like 127.0.0.1.
ALLOW_PRIVATE_WEBHOOKS=false
