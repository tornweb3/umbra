# Copy to .env and fill in. Never commit the real file.

# Postgres. Apply the schema with `npm run migrate` (or it runs on container
# start); `npm run migrate --status` lists what has been applied.
DATABASE_URL=postgres://gateway:CHANGEME@127.0.0.1:5432/xmr_gateway

# 32-byte hex (64 chars). Encrypts merchant view keys and Shopify credentials
# at rest. Generate once: openssl rand -hex 32
# Changing it makes every stored view key undecryptable.
MASTER_KEY=

# Password monero-wallet-rpc uses for the wallet files it creates.
WALLET_PASSWORD=

# monero-wallet-rpc, started with --wallet-dir. Runs against your own node.
WALLET_RPC_URL=http://127.0.0.1:18083/json_rpc
# monerod. A public node works for testing; run your own in production.
DAEMON_RPC_URL=http://127.0.0.1:18081/json_rpc
# mainnet | stagenet | testnet — must match how wallet-rpc was started.
MONERO_NETWORK=mainnet

PORT=3000
# Loopback unless something else controls access to the port (e.g. a container).
BIND_ADDRESS=127.0.0.1
# Public HTTPS origin. Checkout links, Shopify webhooks and buyer pay links are
# built from this, so it must be the final host (no redirect to www).
PUBLIC_BASE_URL=https://pay.example.com

# Exchange rates. A fetched rate more than this far from the last known one is
# treated as a bad tick and ignored; when no provider is reachable the last
# known rate is served for up to RATE_MAX_STALE_MS, and after that a quote is
# refused rather than guessed.
RATE_JUMP_REJECT_PCT=50
RATE_MAX_STALE_MS=600000

# Pre-minted subaddresses, so anything an anonymous visitor can trigger never
# takes the wallet lock. Raised automatically when a merchant creates their
# first payment page or till; 0 disables it.
SUBADDRESS_POOL_TARGET=100
SUBADDRESS_POOL_BATCH=25

# How long a point-of-sale enrolment code is good for.
ENROL_CODE_TTL_MIN=10

# Worker loop and confirmation threshold.
POLL_INTERVAL_MS=15000
CONFIRMATIONS=10
# Drop a detected 0-conf payment whose tx vanished after this many minutes.
REVERT_AFTER_MIN=30
# Give up on a webhook after this many attempts (exponential backoff).
WEBHOOK_MAX_ATTEMPTS=8

# Shopify bridge (optional).
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SYNC_INTERVAL_MS=120000
SHOPIFY_INVOICE_EXPIRY_MIN=60
# Testing only: routes Admin API calls to tools/shopify-mock.mjs. Leave unset.
# SHOPIFY_TEST_API_BASE=http://127.0.0.1:4100

# ---- merchant console -----------------------------------------------------
# The console lives at /portal and is served by this same process.
# Set to 1 to switch it off entirely, for an API-only deployment.
# PORTAL_DISABLED=0

# How long a console session lasts: idle, then absolutely regardless of use.
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_TTL_HOURS=168

# ---- security -------------------------------------------------------------
# Account creation is disabled unless this is set, and it has a second job:
# opening the first-run setup page to a browser that is not on this machine.
# Set it, create your merchant, then remove it again. For the API it is sent
# as the X-Signup-Token header; for setup, as ?token= on /portal/setup.
SIGNUP_TOKEN=

# Set when the gateway runs behind a reverse proxy, so rate limits see the real
# client IP: "1" trusts one hop, or give a subnet (e.g. 10.0.0.0/8).
# It has two further effects worth knowing: the console session cookie is
# marked Secure when the proxy reports X-Forwarded-Proto: https, and the
# first-run setup page stops trusting "the request came from a private
# address" (behind a proxy, every request appears to), so it then requires
# SIGNUP_TOKEN.
TRUST_PROXY=

# Webhook URLs that resolve to private or loopback addresses are refused, which
# stops the gateway being used to reach inside your network. Only turn this on
# for local testing against something like 127.0.0.1.
ALLOW_PRIVATE_WEBHOOKS=false
